# Marvel Atlas is a client-side demo and uses only Marvel's public browser key.
# This value is bundled into client-side JavaScript and is not a secret.
# The repository includes a demo public key; set this only to override it locally.
VITE_MARVEL_PUBLIC_KEY=your_public_marvel_key

# Never add MARVEL_PRIVATE_KEY or any other private credential to Vite variables,
# GitHub Pages, committed files, or browser-delivered JavaScript.

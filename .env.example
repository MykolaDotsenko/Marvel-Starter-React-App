# Local browser development only. This is a public key and may be exposed to
# client-side code. Never put the Marvel private key in a VITE_* variable.
VITE_MARVEL_PUBLIC_KEY=your_public_marvel_key

# Production / Vercel Function credentials.
# Configure these in Vercel Environment Variables, never in committed .env files.
MARVEL_PUBLIC_KEY=your_public_marvel_key
MARVEL_PRIVATE_KEY=your_private_marvel_key
